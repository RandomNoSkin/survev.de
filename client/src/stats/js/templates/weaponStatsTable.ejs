<table id='leaderboard-table'>
  <thead>
    <tr class='leaderboard-headers'>
      <th class='header-rank' scope="col" data-l10n='stats-rank' data-caps='true'>RANK</th>
      <th class='header-player' scope="col" data-l10n='stats-weapon' data-caps='true'>WEAPON</th>
      <th class='header-stat' scope="col" data-l10n='stats-total-damage' data-caps='true'>TOTAL DAMAGE</th>
      <th class='header-stat' scope="col" data-l10n='stats-avg-damage-per-game' data-caps='true'>AVG DMG/GAME</th>
      <th class='header-games' scope="col" data-l10n='stats-kills' data-caps='true'>KILLS</th>
      <th class='header-games' scope="col" data-l10n='stats-avg-kills-per-game' data-caps='true'>AVG KILLS/GAME</th>
      <th class='header-games' scope="col" data-l10n='stats-games' data-caps='true'>GAMES</th>
    </tr>
  </thead>
  <tbody class='leaderboard-values'>
    <% if (!env.data.length) { %>
      <tr class='main single-player'>
        <td colspan="7" class='data-rank' data-l10n='stats-no-data'>No data for this range.</td>
      </tr>
    <% } %>
    <% for (var i = 0, data = env.data; i < data.length; i++) { %>
      <tr class='main single-player'>
        <td class='data-rank' scope="row">#<%= i + 1 %></td>
        <td class='data-player-names'>
          <span class='player-name'><%= data[i].name %></span>
        </td>
        <td><%= data[i].totalDamage %></td>
        <td><%= data[i].avgDamagePerGame %></td>
        <td><%= data[i].kills %></td>
        <td><%= data[i].avgKillsPerGame %></td>
        <td><%= data[i].gamesUsed %></td>
      </tr>
    <% } %>
  </tbody>
</table>
